{
  "name": "@conf-platform/preview-app",
  "version": "1.0.0",
  "description": "Eventos SRR Preview workstation and admin client for Venue Server",
  "author": "Eventos",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev --port 3007",
    "desktop:dev": "node electron/dev-runner.mjs",
    "desktop:dev:next": "next dev --port 3007",
    "desktop:dev:electron": "wait-on http://127.0.0.1:3007 && tsc -p electron/tsconfig.json && electron electron-dist/main.js",
    "desktop:build:electron": "tsc -p electron/tsconfig.json",
    "desktop:preflight": "node scripts/preflight-package.mjs",
    "desktop:pack": "npm run build && npm run desktop:build:electron && npm run desktop:preflight && electron-builder --dir",
    "desktop:msi": "npm run build && npm run desktop:build:electron && npm run desktop:preflight && electron-builder --win msi",
    "test:e2e": "playwright test",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.1",
    "recharts": "^2.14.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "38.7.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wait-on": "^9.0.3",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.61.1"
  },
  "build": {
    "appId": "com.eventos.venue.srr-preview",
    "productName": "Eventos SRR Preview",
    "artifactName": "Eventos-SRR-Preview-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "components/**/*",
      "electron-dist/**/*",
      "hooks/**/*",
      "lib/**/*",
      "public/**/*",
      "store/**/*",
      ".next/**/*",
      "next.config.mjs",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Eventos"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eventos SRR Preview"
    }
  }
}
