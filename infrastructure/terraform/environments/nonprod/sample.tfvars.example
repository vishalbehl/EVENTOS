worker_image              = "111122223333.dkr.ecr.ap-south-1.amazonaws.com/Event-nonprod/workers:immutable-tag"
alert_email               = "operations@example.com"
monthly_budget_usd        = 50
public_demo_signup_enabled = false

portal_origins = [
  "https://command.sample.example.com",
