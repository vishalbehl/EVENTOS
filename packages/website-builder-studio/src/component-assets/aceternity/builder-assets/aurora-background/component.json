{
  "schemaVersion": 1,
  "id": "aceternity-aurora-background",
  "name": "Aurora Background",
  "kind": "component",
  "group": "Aceternity",
  "description": "Animated aurora hero background with editable heading and supporting copy.",
  "tags": [
    "aceternity",
    "background",
    "hero",
    "animation"
  ],
  "preview": {
    "accent": "#8b5cf6",
    "background": "#070812",
    "title": "Aurora Background",
    "subtitle": "Editable component"
  },
  "componentType": "aceternity-aurora-background",
  "componentVersion": 1,
  "htmlFile": "./component.html",
  "officialSource": {
    "documentationUrl": "https://ui.aceternity.com/components/aurora-background",
    "registryUrl": "https://ui.aceternity.com/registry/aurora-background.json",
    "localRegistryPath": "./registry/aurora-background.json",
    "author": "Manu Arora <hi@manuarora.in>",
    "licenseUrl": "https://ui.aceternity.com/licence",
    "dependencies": []
  },
  "settings": [
    {
      "groupId": "CONTENT",
      "properties": [
        {
          "id": "data-heading",
          "type": "Text",
          "label": "Heading",
          "target": {
            "kind": "content",
            "selector": "h1,h2,h3"
          }
        },
        {
          "id": "data-description",
          "type": "Text",
          "label": "Description",
          "target": {
            "kind": "content",
            "selector": "p"
          }
        },
        {
          "id": "background-color",
          "type": "Color",
          "label": "Background",
          "defaultValue": "#06070d",
          "target": {
            "kind": "style",
            "css": "background-color",
            "selector": ":self"
          }
        },
        {
          "id": "heading-color",
          "type": "Color",
          "label": "Heading color",
          "defaultValue": "#f8fafc",
          "target": {
            "kind": "style",
            "css": "color",
            "selector": "h1,h2,h3"
          }
        },
        {
          "id": "text-color",
          "type": "Color",
          "label": "Text color",
          "defaultValue": "#aeb7c8",
          "target": {
            "kind": "style",
            "css": "color",
            "selector": "p"
          }
        },
        {
          "id": "effect-primary",
          "type": "Color",
          "label": "Effect primary",
          "defaultValue": "#8b5cf6",
          "target": {
            "kind": "style",
            "css": "--ac-primary",
            "selector": ":self"
          }
        },
        {
          "id": "effect-secondary",
          "type": "Color",
          "label": "Effect secondary",
          "defaultValue": "#22d3ee",
          "target": {
            "kind": "style",
            "css": "--ac-secondary",
            "selector": ":self"
          }
        }
      ]
    }
  ],
  "capabilities": {
    "theme": true,
    "animation": true,
    "responsive": true
  }
}
