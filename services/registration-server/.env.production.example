DEPLOYMENT_PROFILE=production
ENV=production
HOST=0.0.0.0
PORT=8001

VENUE_AUTH_KEY=replace-with-rotated-registration-server-key
VENUE_AUTH_SECRET=replace-with-registration-server-secret-at-least-32-chars
VENUE_BOOTSTRAP_ADMIN_USERNAME=admin
VENUE_BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
VENUE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
VENUE_BOOTSTRAP_ADMIN_NAME=Registration Administrator

DATABASE_URL=postgresql+asyncpg://registration_user:replace@registration-postgres-host:5432/registration_db

REGISTRATION_FETCH_SOURCE_TYPE=cloud
CLOUD_API_URL=https://api.your-domain.com
CLOUD_API_KEY=replace-with-legacy-service-secret-if-still-required
CLOUD_DEVICE_KEY=generated-from-operations-console

REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=storage.your-domain.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
LOCAL_BUCKET_NAME=registration-local
