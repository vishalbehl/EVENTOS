DEPLOYMENT_PROFILE=local
environment=development
debug=true
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3005,http://127.0.0.1:3005

DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/eventos_db
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/eventos_db
REQUIRE_RLS_SAFE_RUNTIME_ROLE=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

STORAGE_MODE=s3
STORAGE_LOCAL_PATH=data/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

JWT_SECRET_KEY=change-me-for-local-development-only-32chars
PROPOSAL_SHARE_SECRET=change-me-for-local-development-only-32chars
CLOUD_API_KEY=change-me-for-local-development-only-32chars
FERNET_KEY=
PORTAL_JWT_SECRET=change-me-for-local-development-only-32chars
PAYMENT_SECRET_KEY=

ENFORCE_PRIVILEGED_MFA=false
COMMAND_CENTER_COOKIE_SECURE=false
COMMAND_CENTER_COOKIE_SAMESITE=lax
