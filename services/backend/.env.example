DEPLOYMENT_PROFILE=local
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/eventos_db
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/eventos_db
environment=development
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STORAGE_MODE=s3
STORAGE_LOCAL_PATH=data/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRESENTATIONS=presentations
S3_BUCKET_POSTERS=posters
S3_BUCKET_THUMBNAILS=thumbnails
S3_BUCKET_IMPORTS=imports
S3_BUCKET_ASSETS=assets
S3_BUCKET_EXPORTS=exports
S3_BUCKET_REGISTRATION_UPLOADS=registration-uploads
MAX_FILE_SIZE_MB=500
INLINE_UPLOAD_MAX_MB=10
JWT_SECRET_KEY=change-me-for-local-development-only
PROPOSAL_SHARE_SECRET=change-me-for-local-development-only
CLOUD_API_KEY=change-me-for-local-development-only
FERNET_KEY=
PORTAL_JWT_SECRET=
PAYMENT_SECRET_KEY=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
ENFORCE_PRIVILEGED_MFA=false
COMMAND_CENTER_ACCESS_TOKEN_EXPIRE_MINUTES=15
COMMAND_CENTER_COOKIE_NAME=cc_refresh
# Enable in HTTPS production environments.
COMMAND_CENTER_COOKIE_SECURE=false
COMMAND_CENTER_COOKIE_SAMESITE=lax
COMMAND_CENTER_LOGIN_ACCOUNT_LIMIT=5
COMMAND_CENTER_LOGIN_IP_LIMIT=20
COMMAND_CENTER_LOGIN_WINDOW_SECONDS=900
COMMAND_CENTER_ACCOUNT_LOCK_SECONDS=900
COMMAND_CENTER_IP_LOCK_SECONDS=1800
# Comma-separated proxy addresses/CIDRs allowed to provide forwarding headers.
TRUSTED_PROXY_CIDRS=
REQUIRE_RLS_SAFE_RUNTIME_ROLE=false
ENABLE_DEVELOPMENT_BOOTSTRAP=false
PUBLIC_DEMO_SIGNUP_ENABLED=false
PUBLIC_DEMO_PLAN_NAME=Demo Public
PUBLIC_DEMO_RETENTION_DAYS=14

# Invoice issuer and certificate-backed PDF signing. Keep PKCS#12 files outside
# the repository and mount them read-only in deployed environments.
INVOICE_ISSUER_NAME=EventOS IT Solutions
INVOICE_ISSUER_ADDRESS=Delhi, India
INVOICE_ISSUER_GSTIN=
INVOICE_ISSUER_PAN=
INVOICE_ISSUER_SAC=998314
INVOICE_ISSUER_WEBSITE=www.eventos.com
INVOICE_ISSUER_EMAIL=billing@eventos.com
INVOICE_ISSUER_PHONE=+91 11 4703 8800
INVOICE_SIGNING_PKCS12_PATH=
INVOICE_SIGNING_PKCS12_PASSWORD=
INVOICE_SIGNER_NAME=EventOS IT Solutions
INVOICE_SIGNING_REASON=Authorised EventOS tax invoice
INVOICE_SIGNING_LOCATION=Delhi, India
INVOICE_SIGNING_TSA_URL=
INVOICE_PDF_REQUIRE_CRYPTOGRAPHIC_SIGNATURE=false

# For complete profiles, use:
# - .env.local.example
# - .env.production.example
