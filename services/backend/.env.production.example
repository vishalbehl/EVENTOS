DEPLOYMENT_PROFILE=production
environment=production
debug=false
API_BASE_URL=https://api.your-domain.com
CORS_ORIGINS=https://command.your-domain.com,https://organizer.your-domain.com,https://registration.your-domain.com,https://speakers.your-domain.com

DATABASE_URL_SYNC=postgresql+psycopg2://app_runtime_user:replace@cloud-postgres-host:5432/eventos_db
DATABASE_URL_ASYNC=postgresql+asyncpg://app_runtime_user:replace@cloud-postgres-host:5432/eventos_db
REQUIRE_RLS_SAFE_RUNTIME_ROLE=true

REDIS_URL=rediss://default:replace@redis-host:6379/0
CELERY_BROKER_URL=rediss://default:replace@redis-host:6379/0
CELERY_RESULT_BACKEND=rediss://default:replace@redis-host:6379/1

STORAGE_MODE=s3
S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=https://cdn.your-domain.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_BUCKET_PRESENTATIONS=presentations
S3_BUCKET_POSTERS=posters
S3_BUCKET_THUMBNAILS=thumbnails
S3_BUCKET_IMPORTS=imports
S3_BUCKET_ASSETS=assets
S3_BUCKET_EXPORTS=exports

JWT_SECRET_KEY=replace-with-rotated-secret-at-least-32-chars
PROPOSAL_SHARE_SECRET=replace-with-independent-secret-at-least-32-chars
CLOUD_API_KEY=replace-with-internal-service-secret-at-least-32-chars
FERNET_KEY=replace-with-fernet-key
PORTAL_JWT_SECRET=replace-with-portal-secret-at-least-32-chars
PAYMENT_SECRET_KEY=replace-with-fernet-key

ENFORCE_PRIVILEGED_MFA=true
COMMAND_CENTER_COOKIE_SECURE=true
COMMAND_CENTER_COOKIE_SAMESITE=lax
COMMAND_CENTER_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Legal invoice identity and a read-only mounted PKCS#12 signing secret.
INVOICE_ISSUER_NAME=EventOS IT Solutions
INVOICE_ISSUER_ADDRESS=replace-with-registered-address
INVOICE_ISSUER_GSTIN=replace-with-gstin
INVOICE_ISSUER_PAN=replace-with-pan
INVOICE_ISSUER_SAC=998314
INVOICE_ISSUER_WEBSITE=www.eventos.com
INVOICE_ISSUER_EMAIL=billing@eventos.com
INVOICE_ISSUER_PHONE=replace-with-billing-phone
INVOICE_SIGNING_PKCS12_PATH=/run/secrets/eventos-invoice-signing.p12
INVOICE_SIGNING_PKCS12_PASSWORD=replace-through-secret-manager
INVOICE_SIGNER_NAME=EventOS IT Solutions
INVOICE_SIGNING_REASON=Authorised EventOS tax invoice
INVOICE_SIGNING_LOCATION=Delhi, India
INVOICE_SIGNING_TSA_URL=
INVOICE_PDF_REQUIRE_CRYPTOGRAPHIC_SIGNATURE=true
