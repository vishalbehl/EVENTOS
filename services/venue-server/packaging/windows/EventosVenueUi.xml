<service>
  <id>EventosVenueUi</id>
  <name>Eventos Venue UI</name>
  <description>Local Venue Server operations console.</description>
  <executable>%BASE%\..\runtime\node\node.exe</executable>
  <arguments>%BASE%\..\ui\server.js</arguments>
  <workingdirectory>%BASE%\..\ui</workingdirectory>
  <env name="PORT" value="3006" />
  <env name="HOSTNAME" value="127.0.0.1" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>10</keepFiles></log>
</service>
