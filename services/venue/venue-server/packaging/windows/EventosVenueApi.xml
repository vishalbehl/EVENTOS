<service>
  <id>EventosVenueApi</id>
  <name>Eventos Venue API</name>
  <description>Offline-first Eventos Venue Server API and durable workers.</description>
  <executable>%BASE%\..\runtime\python\python.exe</executable>
  <arguments>-m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1</arguments>
  <workingdirectory>%BASE%\..\services\venue-server</workingdirectory>
  <env name="ENV_FILE" value="%ProgramData%\Eventos\VenueServer\venue.env" />
  <depend>EventosVenuePostgres</depend>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>10</keepFiles></log>
</service>
