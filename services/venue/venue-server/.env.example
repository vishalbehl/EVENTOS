DEPLOYMENT_PROFILE=local
ENV=development

# Optional production overrides. Without these values, first boot creates admin / admin123.
# Replace the default secret and password before exposing the Venue Server beyond a trusted local network.
VENUE_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used only when the local identity.venue_users table is empty.
VENUE_BOOTSTRAP_ADMIN_USERNAME=admin
VENUE_BOOTSTRAP_ADMIN_EMAIL=admin@eventos.com
VENUE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
VENUE_BOOTSTRAP_ADMIN_NAME=Venue Administrator
VENUE_ACCESS_TOKEN_MINUTES=480

# Local services
DATABASE_URL=postgresql+asyncpg://postgres:venue_password@localhost:5433/venue_db
CLOUD_API_URL=http://127.0.0.1:8002

# Local Venue Server database and PgAdmin dashboard
VENUE_DB_USER=postgres
VENUE_DB_PASSWORD=venue_password
VENUE_DB_NAME=venue_db
PGADMIN_DEFAULT_EMAIL=admin@eventos.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# For complete profiles, use:
# - .env.local.example
# - .env.production.example
