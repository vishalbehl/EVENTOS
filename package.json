{
  "name": "conf-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/cloud/*",
    "apps/venue/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "powershell -Command \"cd services/backend; if (Test-Path .venv/Scripts/python.exe) { .venv/Scripts/python.exe dev_runner.py --port 8000 } else { python dev_runner.py --port 8000 }\"",
    "dev:worker": "powershell -Command \"cd services/backend; if (Test-Path .venv/Scripts/python.exe) { .venv/Scripts/python.exe -m celery -A app.worker worker --loglevel=info -P solo } else { celery -A app.worker worker --loglevel=info -P solo }\"",
    "dev:command-center": "npm --workspace apps/cloud/command-center run dev -- --webpack",
    "dev:organiser-portal": "npm --workspace apps/cloud/organiser-portal run dev -- --webpack",
    "dev:portal": "npm --workspace apps/cloud/event-portal run dev -- --port 3003 --webpack",
    "dev:speaker": "npm --workspace apps/cloud/event-portal run dev -- --port 3003 --webpack",
    "dev:registration": "npm --workspace apps/cloud/event-portal run dev -- --port 3003 --webpack",
    "dev:venue-server": "powershell -Command \"cd services/venue/venue-server; if (Test-Path .venv/Scripts/python.exe) { .venv/Scripts/python.exe dev_runner.py --port 8001 } else { python dev_runner.py --port 8001 }\"",
    "dev:registration-server": "powershell -Command \"cd services/venue/registration-server; if (Test-Path .venv/Scripts/python.exe) { .venv/Scripts/python.exe dev_runner.py --port 8002 } else { python dev_runner.py --port 8002 }\"",
    "dev:venue-registration": "npm --workspace apps/venue/registration run dev -- --port 3005 --webpack",
    "desktop:venue-registration": "npm --workspace apps/venue/registration run desktop:dev",
    "dev:preview-app": "npm --workspace apps/venue/preview-app run dev -- --port 3007 --webpack",
    "dev:srr": "npm --workspace apps/venue/preview-app run dev -- --port 3007 --webpack",
    "desktop:preview-app": "npm --workspace apps/venue/preview-app run desktop:dev",
    "desktop:srr": "npm --workspace apps/venue/preview-app run desktop:dev",
    "dev:venue-server-app": "npm --workspace apps/venue/venue-server-app run dev -- --port 3006 --webpack",
    "desktop:venue-server-app": "npm --workspace apps/venue/venue-server-app run desktop:dev",
    "dev:room-presentation": "npm --workspace apps/venue/room-presentation run dev",
    "desktop:room-presentation": "npm --workspace apps/venue/room-presentation run electron:dev",
    "dev:technician-dashboard": "npm --workspace apps/venue/technician-dashboard run dev",
    "dev::backend": "npm run dev:backend",
    "dev::worker": "npm run dev:worker",
    "dev::command-center": "npm run dev:command-center",
    "dev::organiser-portal": "npm run dev:organiser-portal",
    "dev::portal": "npm run dev:portal",
    "dev::speaker": "npm run dev:speaker",
    "dev::registration": "npm run dev:registration",
    "dev::venue-server": "npm run dev:venue-server",
    "dev::registration-server": "npm run dev:registration-server",
    "dev::venue-registration": "npm run dev:venue-registration",
    "desktop::venue-registration": "npm run desktop:venue-registration",
    "dev::preview-app": "npm run dev:preview-app",
    "dev::srr": "npm run dev:srr",
    "desktop::preview-app": "npm run desktop:preview-app",
    "desktop::srr": "npm run desktop:srr",
    "dev::venue-server-app": "npm run dev:venue-server-app",
    "desktop::venue-server-app": "npm run desktop:venue-server-app",
    "dev::room-presentation": "npm run dev:room-presentation",
    "desktop::room-presentation": "npm run desktop:room-presentation",
    "dev::technician-dashboard": "npm run dev:technician-dashboard",
    "build": "echo \"Define monorepo build orchestration\""
  },
  "dependencies": {
    "docx": "^9.7.1",
    "grapesjs": "^0.23.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
