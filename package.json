{
  "name": "conf-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/cloud/*",
    "apps/venue/*",
    "packages/*"
  ],
  "scripts": {
    "dev:command-center": "npm --workspace apps/cloud/command-center run dev -- --webpack",
    "dev:organiser-portal": "npm --workspace apps/cloud/organiser-portal run dev -- --webpack",
    "dev:speaker": "npm --workspace apps/cloud/speaker-portal run dev -- --webpack",
    "dev:registration": "npm --workspace apps/cloud/registration-portal run dev -- --port 3003 --webpack",
    "dev:venue-server": "npm --workspace services/venue-server run dev -- --port 8001",
    "dev:venue-registration": "npm --workspace apps/venue/registration run dev -- --port 3004 --webpack",
    "build": "echo \"Define monorepo build orchestration\""
  },
  "dependencies": {
    "docx": "^9.7.1",
    "grapesjs": "^0.23.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
