{
  "name": "conf-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/cloud/*",
    "apps/venue/*",
    "packages/*"
  ],
  "scripts": {
    "dev:command-center": "npm --workspace apps/cloud/command-center run dev -- --webpack",
