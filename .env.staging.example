# Copy to .env.staging and replace every placeholder before starting staging.
# Do not commit .env.staging.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/eventos_db
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
REDIS_LOCK_URL=redis://127.0.0.1:6379/3
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
API_BASE_URL=http://127.0.0.1:8001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_APP_ACCESS_KEY=confplatform-staging-app
MINIO_APP_SECRET_KEY=replace-with-another-long-random-password
STORAGE_MODE=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=replace-with-minio-application-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-application-secret-key
S3_REGION=us-east-1
ANTIVIRUS_REQUIRED=true
ANTIVIRUS_COMMAND=tcp://127.0.0.1:3310
MAX_FILE_SIZE_MB=500
INLINE_UPLOAD_MAX_MB=10
PORTAL_JWT_SECRET=replace-with-at-least-32-random-characters
STAGING_DASHBOARD_EVENT_ID=
STAGING_DASHBOARD_EMAIL=load-1@local.invalid
